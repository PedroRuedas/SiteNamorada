@model SiteNamorada.Models.LoginViewModel

<div class="auth-container">

    <div class="login-box">

        <div class="heart-icon">❤️</div>

        <h1>Bem-vinda</h1>

        <p class="subtitle">
            Entre para acessar nosso cantinho especial
        </p>

        <form method="post">

            <div class="input-group">
                <input asp-for="Email" placeholder="Seu email" />
            </div>

            <div class="input-group">
                <input asp-for="Senha"
                       type="password"
                       placeholder="Sua senha" />
            </div>

            <button class="btn-love">
                Entrar
            </button>

        </form>

        <a class="register-link"
           href="/Account/Cadastro">
            Criar conta
        </a>

    </div>

</div>