@model SiteNamorada.Models.CadastroViewModel

<div class="auth-container">

    <div class="login-box">

        <div class="heart-icon">💕</div>

        <h1>Criar Conta</h1>

        <p class="subtitle">
            Faça parte da nossa história
        </p>

        <form method="post">

            <div class="input-group">
                <input asp-for="Nome" placeholder="Seu nome" />
            </div>

            <div class="input-group">
                <input asp-for="Email" placeholder="Seu email" />
            </div>

            <div class="input-group">
                <input asp-for="Senha"
                       type="password"
                       placeholder="Sua senha" />
            </div>

            <button class="btn-love">
                Cadastrar
            </button>

        </form>

    </div>

</div>