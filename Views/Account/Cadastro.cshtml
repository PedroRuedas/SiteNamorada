@model SiteNamorada.Models.CadastroViewModel

<div class="login-box">

    <h1>Cadastro ❤️</h1>

    <form method="post">

        <input asp-for="Nome" placeholder="Nome" />

        <input asp-for="Email" placeholder="Email" />

        <input asp-for="Senha"
               type="password"
               placeholder="Senha" />

        <button>Cadastrar</button>

    </form>

</div>